<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Controller">
   <center>
      <VBox prefHeight="400.0" prefWidth="598.0" BorderPane.alignment="CENTER">
         <children>
            <TextField fx:id="noteTitle" alignment="TOP_CENTER" promptText="Enter title" style="-fx-border-color: black;" />
            <TextArea fx:id="noteContent" prefHeight="1.0" prefWidth="689.0" promptText="Enter note content" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="addButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#addNote" prefHeight="26.0" prefWidth="79.0" text="Add" textAlignment="CENTER" />
                  <Button fx:id="deleteButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#deleteNote" prefHeight="26.0" prefWidth="79.0" text="Delete" textAlignment="CENTER" />
                  <Button fx:id="editButton" alignment="CENTER" contentDisplay="CENTER" layoutX="310.0" layoutY="47.0" mnemonicParsing="false" onAction="#editNote" prefHeight="26.0" prefWidth="79.0" text="Edit Note" textAlignment="CENTER" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <ListView fx:id="displayNotes" prefHeight="200.0" prefWidth="200.0" />
         </children>
      </VBox>
   </bottom>
</BorderPane>
